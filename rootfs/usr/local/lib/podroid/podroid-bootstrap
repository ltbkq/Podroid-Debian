#!/bin/sh
# Podroid VM system bootstrap — port of upstream openrc podroid-bootstrap.
# Logic kept verbatim; every mount is guarded with mountpoint -q so systemd's
# own devpts/shm/mqueue/cgroup2 mounts simply no-op here. Contract: writes
# "Loading kernel modules..." to the console (BootStageDetector/build-all.sh).
#
# Runs as a systemd oneshot (podroid-bootstrap.service); stdout goes to the
# journal AND the console marker is written explicitly as before.
set -u
CONSOLE=/dev/console

echo "Loading kernel modules..." > "$CONSOLE"

# AVF has no emulated RTC: seed the clock from cmdline podroid.epoch=.
PODROID_EPOCH=$(sed -n 's/.*podroid\.epoch=\([0-9]*\).*/\1/p' /proc/cmdline)
if [ -n "$PODROID_EPOCH" ] && [ "$PODROID_EPOCH" -gt 0 ] 2>/dev/null; then
    date -s "@$PODROID_EPOCH" >/dev/null 2>&1
fi

# Rootless containers need / to be a shared mount so userns mounts propagate.
mount --make-rshared / 2>/dev/null || true

# /dev sub-mounts (idempotent; systemd already provides most of these).
mkdir -p /dev/pts /dev/shm /dev/mqueue 2>/dev/null
mountpoint -q /dev/pts    || mount -t devpts devpts /dev/pts \
    -o gid=5,mode=0620,ptmxmode=0666,noexec,nosuid
mountpoint -q /dev/shm    || mount -t tmpfs tmpfs /dev/shm -o noexec,nosuid,nodev,size=64m
mountpoint -q /dev/mqueue || mount -t mqueue mqueue /dev/mqueue -o noexec,nosuid,nodev
# configfs backs the LIO iSCSI target (targetcli).
mkdir -p /sys/kernel/config 2>/dev/null
mountpoint -q /sys/kernel/config || mount -t configfs -o nosuid,nodev,noexec \
    configfs /sys/kernel/config || true
[ -c /dev/ptmx ] || mknod /dev/ptmx c 5 2 2>/dev/null
chmod 0666 /dev/ptmx /dev/pts/ptmx 2>/dev/null

[ -r /etc/hostname ] && hostname -F /etc/hostname 2>/dev/null

# All Podroid kernel features are builtin (=y) — no /lib/modules in this image
# (same assumption as upstream Alpine: depmod/modprobe no-op silently).
depmod -a 2>/dev/null || true
for m in 9p 9pnet 9pnet_virtio; do modprobe "$m" 2>/dev/null || true; done

# I/O scheduler per-device (kernel cmdline elevator= was removed in 5.0).
for q in /sys/block/vda/queue/scheduler /sys/block/vdb/queue/scheduler; do
    [ -w "$q" ] && echo mq-deadline > "$q" 2>/dev/null
done

# Downloads share (QEMU virtio-9p only; AVF owns /mnt/downloads via 9p-over-vsock
# in podroid-downloads). Self-gating: no 9p device -> ENODEV, exits silently.
if ! grep -q 'podroid\.backend=avf' /proc/cmdline 2>/dev/null; then
    mkdir -p /mnt/downloads 2>/dev/null
    mount -t 9p -o trans=virtio,version=9p2000.L,rw,msize=262144,cache=mmap,noatime \
        downloads /mnt/downloads 2>/dev/null || true
fi

mkdir -p /dev/net 2>/dev/null
[ -c /dev/net/tun ] || mknod /dev/net/tun c 10 200 2>/dev/null
[ -c /dev/fuse ]    || mknod /dev/fuse   c 10 229 2>/dev/null
chmod 0666 /dev/net/tun /dev/fuse 2>/dev/null

# cgroup v2 subtree controllers
mkdir -p /sys/fs/cgroup 2>/dev/null
mountpoint -q /sys/fs/cgroup || mount -t cgroup2 cgroup2 /sys/fs/cgroup
printf '+cpuset +cpu +io +memory +hugetlb +pids +rdma\n' \
    > /sys/fs/cgroup/cgroup.subtree_control 2>/dev/null

# ZRAM swap: 1.5x RAM, lz4 (gives ~4.5x effective memory under pressure).
if [ -b /dev/zram0 ]; then
    _mem_kb=$(awk '/^MemTotal:/{print $2}' /proc/meminfo)
    echo lz4 > /sys/block/zram0/comp_algorithm 2>/dev/null
    echo $((_mem_kb * 1536)) > /sys/block/zram0/disksize 2>/dev/null
    mkswap /dev/zram0 >/dev/null 2>&1 && swapon -p 100 /dev/zram0 2>/dev/null
fi

# OOM behavior + overcommit (browser-friendly).
[ -w /proc/sys/vm/oom_kill_allocating_task ] && echo 0 > /proc/sys/vm/oom_kill_allocating_task
[ -w /proc/sys/vm/overcommit_memory ] && echo 1 > /proc/sys/vm/overcommit_memory

# Container networking sysctls (bridge modules are builtin or loaded by lxc-net/docker).
sysctl -qw net.ipv4.ip_forward=1 \
    net.ipv4.conf.all.forwarding=1 \
    net.ipv6.conf.all.forwarding=1 \
    net.ipv6.conf.default.forwarding=1 \
    net.bridge.bridge-nf-call-iptables=1 \
    net.bridge.bridge-nf-call-ip6tables=1 2>/dev/null || true

# Bind container stores onto raw ext4: an overlay cannot be the upper of
# another overlay (EINVAL) — Docker/Podman/LXC would fall back or fail.
mkdir -p /mnt/persist/docker /var/lib/docker 2>/dev/null
mountpoint -q /var/lib/docker || mount --bind /mnt/persist/docker /var/lib/docker
mkdir -p /mnt/persist/containers /var/lib/containers/storage 2>/dev/null
mountpoint -q /var/lib/containers/storage \
    || mount --bind /mnt/persist/containers /var/lib/containers/storage
mkdir -p /mnt/persist/lxc /var/lib/lxc 2>/dev/null
mountpoint -q /var/lib/lxc || mount --bind /mnt/persist/lxc /var/lib/lxc

# ==== VMDroid 新增（M2 / DESIGN §4.8 第 5、9 条，2026-10-08）=================
# 镜像构建期已执行 `rm -f /etc/dropbear/dropbear_*_host_key*`，所以公开分发的
# .img 不携带任何私钥（R1: B-R1-2 / R2: B-R2-4）。此处为首启生成点：/etc 走
# overlay → copy-up 到 persist，生成一次后跨重启保留，且每个用户的密钥独立。
# 不采用 dropbear -R 分支（§4.8 定案）。幂等：文件已存在且非空则跳过。
# 本段只追加，未改动上方任何既有行；dropbear.service 已在
# dropbear.service.d/podroid.conf 中 After=podroid-bootstrap.service，先于 SSH 起。
if [ -d /etc/dropbear ] && command -v dropbearkey >/dev/null 2>&1; then
    if [ ! -s /etc/dropbear/dropbear_ed25519_host_key ]; then
        dropbearkey -t ed25519 -f /etc/dropbear/dropbear_ed25519_host_key \
            >/dev/null 2>&1 || echo "podroid-bootstrap: dropbearkey ed25519 failed" >&2
    fi
    if [ ! -s /etc/dropbear/dropbear_rsa_host_key ]; then
        dropbearkey -t rsa -f /etc/dropbear/dropbear_rsa_host_key \
            >/dev/null 2>&1 || echo "podroid-bootstrap: dropbearkey rsa failed" >&2
    fi
fi
# ==== VMDroid 新增结束 ======================================================

exit 0
